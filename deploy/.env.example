# Copy to .env and fill in. NEVER commit .env.
# Generate strong secrets with:  openssl rand -base64 24

ENVIRONMENT=staging              # staging | production
DOMAIN=localhost                 # production: erp.yourcompany.in  (DNS must point to the server)
DB_NAME=HSRTextile
POSTGRES_PASSWORD=
ODOO_MASTER_PASSWORD=
TZ=Asia/Kolkata

IMAGE_TAG=latest
ODOO_WORKERS=2                   # 2 is right for up to ~10 users on a 4 GB server

BACKUP_DIR=./backups             # production: a path on a separate disk / mounted volume
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=2                    # nightly backup hour (server time zone)
