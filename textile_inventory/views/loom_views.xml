<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_loom_list" model="ir.ui.view">
        <field name="name">textile.loom.list</field>
        <field name="model">textile.loom</field>
        <field name="arch" type="xml">
            <list string="Looms">
                <field name="code"/>
                <field name="name"/>
                <field name="allocation_count"/>
            </list>
        </field>
    </record>

    <record id="view_loom_form" model="ir.ui.view">
        <field name="name">textile.loom.form</field>
        <field name="model">textile.loom</field>
        <field name="arch" type="xml">
            <form string="Loom">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_allocations" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="allocation_count" widget="statinfo" string="Allocations"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_loom" model="ir.actions.act_window">
        <field name="name">Looms</field>
        <field name="res_model">textile.loom</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_loom" name="Loom List"
              parent="menu_textile_looms_root" action="action_loom" sequence="10"/>
</odoo>
