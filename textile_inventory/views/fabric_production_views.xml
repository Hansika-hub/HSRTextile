<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- FORM VIEW -->

    <record id="view_fabric_production_form" model="ir.ui.view">
        <field name="name">textile.fabric.production.form</field>
        <field name="model">textile.fabric.production</field>

        <field name="arch" type="xml">
            <form string="Woven Fabric Production">

                <header>

                    <button
                        name="action_produce"
                        string="Produce Fabric"
                        type="object"
                        class="btn-primary"
                        invisible="state == 'done'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,done"
                    />

                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group string="PRODUCTION DETAILS">

                            <field name="date"/>

                            <field
                                name="pavu_product_id"
                                readonly="state == 'done'"
                            />

                            <field
                                name="pavu_quantity"
                                readonly="state == 'done'"
                            />

                        </group>

                        <group string="OUTPUT">

                            <field
                                name="fabric_product_id"
                                readonly="state == 'done'"
                            />

                            <field
                                name="fabric_quantity"
                                readonly="state == 'done'"
                            />

                        </group>

                    </group>

                    <group string="NOTES">
                        <field
                            name="notes"
                            placeholder="Add production notes..."
                            readonly="state == 'done'"
                        />
                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- LIST VIEW -->

    <record id="view_fabric_production_list" model="ir.ui.view">
        <field name="name">textile.fabric.production.list</field>
        <field name="model">textile.fabric.production</field>

        <field name="arch" type="xml">
            <list string="Woven Fabric Production">

                <field name="name"/>
                <field name="date"/>
                <field name="pavu_product_id"/>
                <field name="pavu_quantity"/>
                <field name="fabric_product_id"/>
                <field name="fabric_quantity"/>
                <field name="state"/>

            </list>
        </field>
    </record>


    <!-- ACTION -->

    <record id="action_fabric_production" model="ir.actions.act_window">
        <field name="name">Fabric Production</field>
        <field name="res_model">textile.fabric.production</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- MENU -->

    <menuitem
        id="menu_fabric_production"
        name="Fabric Production"
        parent="textile_inventory.menu_textile_inventory_root"
        action="action_fabric_production"
        sequence="30"
    />

</odoo>
