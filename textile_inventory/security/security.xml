<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Roles. PROPOSED permission matrix: to be confirmed by the business owner. -->
    <record id="privilege_textile" model="res.groups.privilege">
        <field name="name">Textile ERP</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_textile_accountant" model="res.groups">
        <field name="name">Accountant (read only)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_textile"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_textile_supervisor" model="res.groups">
        <field name="name">Production Supervisor</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_textile"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_textile_inventory" model="res.groups">
        <field name="name">Inventory Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_textile"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_textile_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="privilege_textile"/>
        <field name="implied_ids" eval="[(4, ref('group_textile_inventory')), (4, ref('group_textile_supervisor')), (4, ref('stock.group_stock_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_textile_owner" model="res.groups">
        <field name="name">Owner</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="privilege_textile"/>
        <field name="implied_ids" eval="[(4, ref('group_textile_admin'))]"/>
    </record>
</odoo>
