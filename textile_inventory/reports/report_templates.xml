                                        <td class="text-end"><span t-field="l.total_metres"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td><strong>Total</strong></td>
                                    <td class="text-end"><strong><span t-field="o.total_rolls"/></strong></td>
                                    <td class="text-end"><strong><span t-field="o.total_metres"/> m</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                        <p><strong>Status:</strong> <span t-field="o.state"/></p>
                        <div class="row mt-5 pt-5">
                            <div class="col-6">Received by<br/><br/>______________</div>
                            <div class="col-6">Driver / supplier<br/><br/>______________</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============ Worker pay sheet ============ -->
    <record id="action_report_worker_payment" model="ir.actions.report">
        <field name="name">Worker Pay Sheet</field>
        <field name="model">textile.worker.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">textile_inventory.report_worker_payment</field>
        <field name="report_file">textile_inventory.report_worker_payment</field>
        <field name="print_report_name">'Pay Sheet - %s' % object.name</field>
        <field name="binding_model_id" ref="model_textile_worker_payment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_worker_payment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Worker Pay Sheet <span t-field="o.name"/></h2>
                        <p><strong>Worker:</strong> <span t-field="o.worker_id"/>
                           &#160;&#160; <strong>Period:</strong> <span t-field="o.date_from"/> to <span t-field="o.date_to"/>
                           &#160;&#160; <strong>Status:</strong> <span t-field="o.state"/></p>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr><th>Date</th><th>Shift</th><th>Loom</th><th>Order</th>
                                    <th class="text-end">Metres</th><th class="text-end">Rate</th>
                                    <th class="text-end">Amount</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="l">
                                    <tr>
                                        <td><span t-field="l.date"/></td>
                                        <td><span t-field="l.shift"/></td>
                                        <td><span t-field="l.loom_id.name"/></td>
                                        <td><span t-field="l.order_id.name"/></td>
                                        <td class="text-end"><span t-field="l.metres"/></td>
                                        <td class="text-end"><span t-field="l.rate"/></td>
                                        <td class="text-end"><span t-field="l.amount"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4"><strong>Total</strong></td>
                                    <td class="text-end"><strong><span t-field="o.total_metres"/></strong></td>
                                    <td></td>
                                    <td class="text-end"><strong><span t-field="o.total_amount"/></strong></td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="row mt-5 pt-5">
                            <div class="col-6">Approved by<br/><br/>______________</div>
                            <div class="col-6">Worker signature<br/><br/>______________</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
