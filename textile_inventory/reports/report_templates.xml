        <field name="model">textile.pavu.receipt</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">textile_inventory.report_pavu_receipt</field>
        <field name="report_file">textile_inventory.report_pavu_receipt</field>
        <field name="print_report_name">'Pavu Receipt - %s' % object.name</field>
        <field name="binding_model_id" ref="model_textile_pavu_receipt"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_pavu_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Pavu Receipt <span t-field="o.name"/></h2>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td><strong>Date:</strong> <span t-field="o.date"/></td>
                                <td><strong>Vehicle:</strong> <span t-field="o.vehicle_no"/></td>
                            </tr>
                            <tr>
                                <td><strong>Vendor:</strong> <span t-field="o.partner_id"/></td>
                                <td><strong>Order:</strong> <span t-field="o.order_id.name"/></td>
                            </tr>
                        </table>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr><th>Roll length (m)</th><th class="text-end">Number of rolls</th>
                                    <th class="text-end">Total (m)</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="l">
                                    <tr>
                                        <td><span t-field="l.roll_length"/></td>
