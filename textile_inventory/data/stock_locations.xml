<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Loom Allocation location.
         It must be a SIBLING of the godown stock (under the warehouse view
         location), not a child of it. If it were a child, yarn already on
         the looms would be counted as available godown stock. -->
    <record id="location_loom_allocation" model="stock.location">
        <field name="name">Loom Allocation</field>
        <field name="usage">internal</field>
        <field name="location_id"
               search="[('usage', '=', 'view'), ('warehouse_id', '!=', False), ('location_id', '=', False)]"/>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <!-- Finished fabric rolls wait here until dispatch (also a sibling of the
         godown stock, so finished fabric never mixes with raw material). -->
    <record id="location_finished_fabric" model="stock.location">
        <field name="name">Finished Fabric</field>
        <field name="usage">internal</field>
        <field name="location_id"
               search="[('usage', '=', 'view'), ('warehouse_id', '!=', False), ('location_id', '=', False)]"/>
        <field name="company_id" ref="base.main_company"/>
    </record>
</odoo>
