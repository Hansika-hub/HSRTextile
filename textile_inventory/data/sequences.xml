<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_order" model="ir.sequence">
        <field name="name">Vendor Order</field>
        <field name="code">textile.order</field>
        <field name="prefix">ORD/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_yarn_receipt" model="ir.sequence">
        <field name="name">Yarn Receipt</field>
        <field name="code">textile.yarn.receipt</field>
        <field name="prefix">YRN/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_pavu_receipt" model="ir.sequence">
        <field name="name">Pavu Receipt</field>
        <field name="code">textile.pavu.receipt</field>
        <field name="prefix">PAV/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_yarn_allocation" model="ir.sequence">
        <field name="name">Yarn Allocation</field>
        <field name="code">textile.yarn.allocation</field>
        <field name="prefix">ALC/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_production" model="ir.sequence">
        <field name="name">Production Entry</field>
        <field name="code">textile.production</field>
        <field name="prefix">PRD/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_fabric_roll" model="ir.sequence">
        <field name="name">Fabric Roll</field>
        <field name="code">textile.fabric.roll</field>
        <field name="prefix">ROLL/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
